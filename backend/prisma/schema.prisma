generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id            String         @id @default(cuid())
  phone         String         @unique
  jid           String         @unique
  name          String?
  notes         String?
  tags          ContactTag[]
  conversation  Conversation?
  aiRules       AiRule[]
  campaignItems CampaignItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#10b981")
  contacts  ContactTag[]
  aiRules   AiRule[]
  createdAt DateTime     @default(now())
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Conversation {
  id                 String    @id @default(cuid())
  contactId          String    @unique
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mode               String    @default("AUTO") // AUTO | MANUAL
  activeRuleId       String?
  activeRule         AiRule?   @relation("ConversationAssignedRule", fields: [activeRuleId], references: [id], onDelete: SetNull)
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  aiSummary          String?
  aiSummaryUpdatedAt DateTime?
  messages           Message[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?      @unique
  direction      String       // INBOUND | OUTBOUND
  senderType     String       // CONTACT | AI | HUMAN | CAMPAIGN
  body           String
  status         String       @default("SENT") // PENDING | SENT | DELIVERED | READ | FAILED
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AiRule {
  id                    String         @id @default(cuid())
  name                  String
  scope                 String         // GLOBAL | TAG | CONTACT
  isActive              Boolean        @default(true)
  tagId                 String?
  tag                   Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  contactId             String?
  contact               Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  objective             String
  toneOfVoice           String
  knowledgeBase         String
  stopCondition         String
  campaigns             Campaign[]
  assignedConversations Conversation[] @relation("ConversationAssignedRule")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([scope, isActive])
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  messageTemplate     String
  useAiVariation      Boolean        @default(false)
  autoEnableAiOnReply Boolean        @default(true)
  aiRuleId            String?
  aiRule              AiRule?        @relation(fields: [aiRuleId], references: [id], onDelete: SetNull)
  minDelaySec         Int            @default(45)
  maxDelaySec         Int            @default(120)
  batchSize           Int            @default(20)
  batchPauseMin       Int            @default(5)
  status              String         @default("DRAFT") // DRAFT | RUNNING | PAUSED | COMPLETED | CANCELLED
  totalCount          Int            @default(0)
  sentCount           Int            @default(0)
  failedCount         Int            @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  items               CampaignItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model CampaignItem {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name            String
  phone           String
  resolvedMessage String?
  status          String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | CANCELLED
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([campaignId, status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO | SUCCESS | WARN | ERROR
  category  String   // WHATSAPP | AI | CAMPAIGN | SYSTEM
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSettings {
  id                         Int       @id @default(1)
  aiProvider                 String    @default("gemini") // gemini | ollama
  geminiApiKey               String    @default("")
  geminiModel                String    @default("gemini-2.5-flash")
  ollamaBaseUrl              String    @default("http://localhost:11434")
  ollamaModel                String    @default("llama3.2")
  globalAutomationPaused     Boolean   @default(false)
  autoPauseOnManualSend      Boolean   @default(true)
  autoSummarizeConversations Boolean   @default(false)
  defaultMinDelaySec         Int       @default(45)
  defaultMaxDelaySec         Int       @default(120)
  defaultBatchSize           Int       @default(20)
  defaultBatchPauseMin       Int       @default(5)
  lastDailySummary           String?
  lastDailySummaryAt         DateTime?
  updatedAt                  DateTime  @updatedAt
}
