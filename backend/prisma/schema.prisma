generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  avatarUrl     String?
  googleSub     String?        @unique
  passwordHash  String?
  isOwner       Boolean        @default(false)
  settings      UserSettings?
  contacts      Contact[]
  tags          Tag[]
  conversations Conversation[]
  aiRules           AiRule[]
  trainingExamples  AiTrainingExample[]
  aiUsageLogs       AiUsageLog[]
  campaigns         Campaign[]
  activityLogs      ActivityLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserSettings {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider                 String    @default("gemini") // gemini | ollama
  geminiApiKey               String    @default("")
  geminiModel                String    @default("gemini-3.8-flash")
  ollamaBaseUrl              String    @default("http://localhost:11434")
  ollamaModel                String    @default("llama3.2")
  globalAutomationPaused     Boolean   @default(false)
  autoPauseOnManualSend      Boolean   @default(true)
  autoSummarizeConversations Boolean   @default(false)
  enableImageReading         Boolean   @default(false)
  geminiVisionModel          String    @default("")
  imageAnalysisPrompt        String    @default("Descreva a imagem de forma objetiva em português para ajudar no atendimento de WhatsApp. Extraia textos legíveis, valores, datas, códigos, comprovantes ou detalhes do produto/erro mostrados.")
  enableAudioTranscription   Boolean   @default(false)
  geminiAudioModel           String    @default("")
  audioTranscriptionPrompt   String    @default("Transcreva fielmente o áudio enviado no WhatsApp em português. Se houver informações importantes no tom ou contexto, adicione uma breve observação entre colchetes ao final.")
  dailyAiRequestLimit        Int       @default(250)
  defaultMinDelaySec         Int       @default(45)
  defaultMaxDelaySec         Int       @default(120)
  defaultBatchSize           Int       @default(20)
  defaultBatchPauseMin       Int       @default(5)
  lastDailySummary           String?
  lastDailySummaryAt         DateTime?
  updatedAt                  DateTime  @updatedAt
}

model Contact {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String
  jid           String
  name          String?
  notes         String?
  tags          ContactTag[]
  conversation  Conversation?
  aiRules       AiRule[]
  campaignItems CampaignItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, phone])
  @@unique([userId, jid])
  @@index([userId])
}

model Tag {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#10b981")
  contacts  ContactTag[]
  aiRules   AiRule[]
  createdAt DateTime     @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Conversation {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId          String    @unique
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mode               String    @default("AUTO") // AUTO | MANUAL
  activeRuleId       String?
  activeRule         AiRule?   @relation("ConversationAssignedRule", fields: [activeRuleId], references: [id], onDelete: SetNull)
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  aiSummary          String?
  aiSummaryUpdatedAt DateTime?
  messages           Message[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?
  direction      String       // INBOUND | OUTBOUND
  senderType     String       // CONTACT | AI | HUMAN | CAMPAIGN
  body            String
  mediaType       String?      // image | audio | null
  imageAnalysis   String?
  audioTranscript String?
  status          String       @default("SENT") // PENDING | SENT | DELIVERED | READ | FAILED
  createdAt      DateTime     @default(now())

  @@unique([conversationId, waMessageId])
  @@index([conversationId, createdAt])
}

model AiRule {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  scope                 String         // GLOBAL | TAG | CONTACT
  isActive              Boolean        @default(true)
  tagId                 String?
  tag                   Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  contactId             String?
  contact               Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  objective             String
  toneOfVoice           String
  knowledgeBase         String
  stopCondition         String
  campaigns             Campaign[]
  assignedConversations Conversation[]      @relation("ConversationAssignedRule")
  trainingExamples      AiTrainingExample[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, scope, isActive])
}

model AiTrainingExample {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            AiRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  customerMessage String
  idealResponse   String
  feedbackNote    String?
  source          String   @default("MANUAL") // MANUAL | SIMULATOR | CONVERSATION
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, ruleId, isActive])
}

model Campaign {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  messageTemplate     String
  useAiVariation      Boolean        @default(false)
  autoEnableAiOnReply Boolean        @default(true)
  aiRuleId            String?
  aiRule              AiRule?        @relation(fields: [aiRuleId], references: [id], onDelete: SetNull)
  minDelaySec         Int            @default(45)
  maxDelaySec         Int            @default(120)
  batchSize           Int            @default(20)
  batchPauseMin       Int            @default(5)
  status              String         @default("DRAFT") // DRAFT | RUNNING | PAUSED | COMPLETED | CANCELLED
  totalCount          Int            @default(0)
  sentCount           Int            @default(0)
  failedCount         Int            @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  items               CampaignItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userId, createdAt])
}

model CampaignItem {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name            String
  phone           String
  resolvedMessage String?
  status          String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | CANCELLED
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([campaignId, status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   @default("INFO") // INFO | SUCCESS | WARN | ERROR
  category  String   // WHATSAPP | AI | CAMPAIGN | SYSTEM
  message   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // gemini | ollama
  model        String
  feature      String   @default("chat") // chat | vision | summary | variation | training | test
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
