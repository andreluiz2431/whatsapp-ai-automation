# ============================================================
# Sistema de Automação e Atendimento Inteligente para WhatsApp
# Configuração 100% Gratuita (Baileys + SQLite + Gemini/Ollama)
# ============================================================

# --- Servidor Backend ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Banco de Dados SQLite (Prisma) ---
DATABASE_URL="file:./dev.db"

# --- Autenticação Multi-Usuário (Google OAuth + E-mail/Senha) ---
# Opcional para ativar o botão "Entrar com Google" (gratuito no Google Cloud Console -> Credenciais -> ID do cliente OAuth Web)
GOOGLE_CLIENT_ID=
# Segredo para assinar cookies de sessão (se vazio, é gerado e salvo automaticamente no volume)
SESSION_SECRET=
# E-mail do administrador/dono que pode herdar a GEMINI_API_KEY inicial (opcional; se vazio, o 1º usuário cadastrado)
OWNER_EMAIL=

# --- Provedor de Inteligência Artificial ---
# Opções: "gemini" (Google Gemini API Free Tier) ou "ollama" (Local)
AI_PROVIDER=gemini

# 1) Google Gemini API (Gratuito em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2) Ollama Local (Gratuito em https://ollama.com - ex: llama3.2, qwen2.5, gemma2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Configurações Padrão Anti-Bloqueio (Campanhas) ---
DEFAULT_MIN_DELAY_SEC=45
DEFAULT_MAX_DELAY_SEC=120
DEFAULT_BATCH_SIZE=20
DEFAULT_BATCH_PAUSE_MIN=5

# --- Comportamento da Automação ---
AUTO_PAUSE_AI_ON_MANUAL_SEND=true

# --- Diretório das Sessões Locais do WhatsApp (1 subpasta por usuário) ---
WHATSAPP_SESSION_DIR=./auth_session
